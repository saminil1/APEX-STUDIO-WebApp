# igccert.org 로컬 Docker 설정 — restore.sh 가 .env 로 복사하고 비밀번호를 자동 생성합니다.
SITE_DOMAIN=igccert.org

# 백업 사이트가 요구하는 PHP 버전 (예: 7.4 / 8.0 / 8.1 / 8.2 / 8.3)
PHP_VERSION=8.2
MARIADB_VERSION=10.11

# 웹 루트가 site/ 아래 하위 폴더면 지정 (예: public_html). 보통 비워둠
DOCROOT_SUBDIR=

DB_NAME=igccert
DB_USER=igccert
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=3306
PMA_PORT=8081

# 선택: Cloudflare Tunnel 토큰 (인터넷 공개 시)
CLOUDFLARE_TUNNEL_TOKEN=
